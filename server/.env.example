# 国土交通省「不動産情報ライブラリ」APIキー
# 取得: https://www.reinfolib.mlit.go.jp/api/request/ (無料の利用登録が必要)
REINFOLIB_API_KEY=

# Google Maps Geocoding API 用キー(サーバー専用。IPアドレス制限をかけて発行してください)
# Google Cloud Console で Geocoding API を有効化して取得
GOOGLE_MAPS_SERVER_API_KEY=

# フロントエンドの開発サーバーのオリジン(CORS許可用)
CLIENT_ORIGIN=http://localhost:5173

PORT=8787
